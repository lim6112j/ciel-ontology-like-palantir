DATABASE_URL=postgresql+asyncpg://ontology:ontology@localhost:55432/ontology
# Domain served by default; every `ontology` command also accepts `--domain`.
ONTOLOGY_DOMAIN=liquor
# Optional per-domain database override, e.g. keep two domains apart:
# DATABASE_URL_LIQUOR=postgresql+asyncpg://ontology:ontology@localhost:55432/ontology_liquor
# DATABASE_URL_BAKERY=postgresql+asyncpg://ontology:ontology@localhost:55432/ontology_bakery

# OpenRouter: only required for agents and `pytest -m live`
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
